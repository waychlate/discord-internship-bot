# Discord Webhook URL (Required)
# Create in Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional: Mention a specific Role ID in Discord on new job notifications (e.g., &123456789012345678)
DISCORD_ROLE_ID=

# Scrape Interval Override in minutes (optional, defaults to config.yaml)
# SCRAPE_INTERVAL_MINUTES=30


# Keyword-search APIs (optional; each is skipped if its keys are missing)
# Adzuna: free keys at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJobs: free key at https://developer.usajobs.gov (USAJOBS_EMAIL = the email you registered with)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
